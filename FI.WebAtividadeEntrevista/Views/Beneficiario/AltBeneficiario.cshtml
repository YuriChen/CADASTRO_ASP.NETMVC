@model WebAtividadeEntrevista.Models.BeneficiarioModel
@{
    ViewBag.Title = "Alterar Beneficiário";
}
@section scripts{
    <script>
        var urlPostBen = '@Url.Action("Alterar", "Beneficiario", new { area = "" })';
        var objBen = @Html.Raw(Json.Encode(Model));
        var urlRetorno = '@Url.Action("Index", "Cliente", new { area = "" })';
    </script>
    @Scripts.Render("~/bundles/altBeneficiarios")
    @Scripts.Render("~/bundles/jquerymask")
    @Scripts.Render("~/bundles/validacaoCpf")
}
<h2>@Html.Raw(ViewBag.Title)</h2>
<form id="formCadastro" method="post">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- 2. Depois, o jQuery Mask -->
    <script src="~/Scripts/jquery.mask.min.js"></script>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="Nome">Nome:</label>
                <input required="required" type="text" class="form-control" id="Nome" name="Nome" placeholder="Ex.: João" maxlength="50">
            </div>
            <div class="form-group">
                <label for="Cpf">CPF:</label>
                <input required="required" type="text" class="form-control" id="Cpf" name="Cpf" placeholder="999.999.999-99" maxlength="255">
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="pull-right">
                <button type="submit" class="btn btn-sm btn-success">Salvar</button>
                @Html.ActionLink("Voltar", "Index", "Cliente", new { }, new { @class = "btn btn-sm btn-danger" })
            </div>
        </div>
    </div>
</form>
<script>

</script>